[sub_resource type="GDScript" id="GDScript_umx1o"]
resource_name = "debug_item"
script/source = "extends Node2D

@onready var player_inventory: Inventory = $\"PlayerInventory\"
@onready var robot_inventory: Inventory = $\"RobotInventory\"
@onready var robot_inventory_2: Inventory = $\"RobotInventory2\"
@onready var robot_inventory_3: Inventory = $RobotInventory3
@onready var label_p: Label = $LabelP
@onready var label_r: Label = $LabelR
@onready var label_r2: Label = $LabelR2
@onready var label_r3: Label = $LabelR3

func _process(delta: float) -> void:
	getInfo(player_inventory, label_p)
	getInfo(robot_inventory, label_r)
	getInfo(robot_inventory_2, label_r2)
	getInfo(robot_inventory_3, label_r3)

func getInfo(inv: Inventory, label: Label):
	label.text = ''
	
	var node_inv = inv.get_node_or_null('%SlotContainer')
	var slotN = 0
	for item in inv.Items:
		var text = ''
		if item != null:
			label.text += 'Slot %d: %s: %s\\n' % [node_inv.get_child(slotN).slot_position, item.name, item.quantity]
		else:
			label.text += 'Slot %d: null\\n' % [node_inv.get_child(slotN).slot_position]
		slotN += 1
"

